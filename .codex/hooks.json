{
  "description": "Ordered validation gates for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/Tools/hook-scope-baseline.ps1\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/Tools/hook-scope-baseline.ps1\"",
            "timeout": 60,
            "statusMessage": "scope-baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/Tools/hook-codex-stop.ps1\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/Tools/hook-codex-stop.ps1\"",
            "timeout": 1200,
            "statusMessage": "project-gates"
          }
        ]
      }
    ]
  }
}
