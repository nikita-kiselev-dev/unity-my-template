<Project Sdk="Microsoft.NET.Sdk">

  <!-- Штатная сборка — Tools/mutation-check.ps1 (Roslyn из поставки Unity, .NET SDK не нужен).
       Этот csproj существует для IDE и для сборки при установленном SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Mutator</AssemblyName>
    <RootNamespace>Mutator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" />
  </ItemGroup>

</Project>
